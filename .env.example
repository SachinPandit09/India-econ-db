# Copy to .env and fill in. Never commit .env. Values are never printed or logged.

# PostgreSQL. Keep the password OUT of the URL: libpq reads PGPASSWORD by itself.
# Format: postgresql://econdb_owner@localhost:5432/econdb
DATABASE_URL=
# Wrap in single quotes if it contains # or spaces.
PGPASSWORD=

# data.gov.in API key (Phase 3)
DATAGOVIN_API_KEY=

# Google Sheets tracker (Phase 5). Key file lives outside the repo.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# GitHub failure issues (Phase 6). Format: owner/repo
GITHUB_REPO=
GITHUB_TOKEN=
